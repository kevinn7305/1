F["retail.py"] = '''from pyspark.sql import SparkSession
from pyspark.sql.functions import sum, avg

spark = SparkSession.builder.appName("RetailAnalysis").getOrCreate()

df = spark.read.csv(
    "/user/cloudera/q7/input/retail.txt",
    header=False,
    inferSchema=True
)

df = df.toDF("Product","Quantity","Price")
df = df.withColumn("Sales", df.Quantity * df.Price)

df.show()

result = df.groupBy("Product").agg(
    sum("Quantity").alias("TotalQuantity"),
    sum("Sales").alias("TotalSales"),
    avg("Sales").alias("AverageSales")
)

result.show()
result.write.mode("overwrite").csv("/user/cloudera/q7/output", header=True)

spark.stop()
'''

