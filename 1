F["mapper3.py"] = '''#!/usr/bin/env python
import sys
for line in sys.stdin:
    matrix, row, col, value = line.strip().split(",")
    row, col, value = int(row), int(col), int(value)
    if matrix == "A":
        for j in range(2):
            print(str(row)+","+str(j)+"\\tA,"+str(col)+","+str(value))
    else:
        for i in range(2):
            print(str(i)+","+str(col)+"\\tB,"+str(row)+","+str(value))
'''

F["reducer3.py"] = '''#!/usr/bin/env python
import sys
data = {}
for line in sys.stdin:
    key, value = line.strip().split("\\t")
    matrix, k, val = value.split(",")
    data.setdefault(key, {}).setdefault(matrix, []).append((int(k), int(val)))
for key in sorted(data):
    a = sorted(data[key].get("A", []))
    b = sorted(data[key].get("B", []))
    result = sum(x[1]*y[1] for x,y in zip(a,b))
    print(key + "\\t" + str(result))
'''

