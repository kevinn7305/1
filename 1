cat > retail.py <<'EOF'
from pyspark import SparkContext
from pyspark.sql import SQLContext

sc = SparkContext()
sql = SQLContext(sc)

data = [
    ("Laptop", "Electronics", 50000),
    ("Phone", "Electronics", 30000),
    ("Rice", "Grocery", 5000),
    ("Oil", "Grocery", 2000),
    ("Chair", "Furniture", 4000),
    ("Table", "Furniture", 8000)
]

columns = ["Product", "Category", "Sales"]
df = sql.createDataFrame(data, columns)

print("1. All Products:")
df.show()

print("2. Products with sales above 5000:")
df.filter(df.Sales > 5000).show()

print("3. Total Sales by Category:")
df.groupBy("Category").sum("Sales").show()

print("4. Highest-Selling Product:")
df.orderBy(df.Sales.desc()).limit(1).show()

print("5. Products sorted by Sales, highest to lowest:")
df.orderBy(df.Sales.desc()).show()

sc.stop()
EOF


