cat > reducer3.py <<'EOF'
#!/usr/bin/env python
import sys
a, b = {}, {}
for line in sys.stdin:
    try:
        tag, val = line.strip().split('\t')
        p = val.split(',')
        i, j, v = int(p[1]), int(p[2]), int(p[3])
        if tag == 'a':
            a[i, j] = v
        elif tag == 'b':
            b[i, j] = v
    except:
        continue
for i in range(2):
    for j in range(2):
        s = sum(a.get((i, k), 0) * b.get((k, j), 0) for k in range(2))
        print("(%d,%d)\t%d" % (i, j, s))
EOF


