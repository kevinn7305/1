# ============================================================
# 1. INSTALL PACKAGES (RUN ONCE IN CONSOLE)
# ============================================================

packages <- c(
  "pdfetch", "quantmod", "readxl", "forecast",
  "ggplot2", "dplyr", "tseries", "zoo", "tidyr",
  "moments", "FinTS", "urca", "vars", "tsDyn",
  "stargazer", "rugarch", "rmgarch", "BEKKs",
  "rmarkdown", "knitr", "tinytex"
)

install.packages(packages, dependencies = TRUE)


# ============================================================
# 2. LOAD ALL LIBRARIES
# ============================================================

library(pdfetch)
library(quantmod)
library(readxl)
library(forecast)
library(ggplot2)
library(dplyr)
library(tseries)
library(zoo)
library(tidyr)
library(moments)
library(FinTS)
library(urca)
library(vars)
library(tsDyn)
library(stargazer)
library(rugarch)
library(rmgarch)
library(BEKKs)
library(rmarkdown)
library(knitr)
library(tinytex)


# ============================================================
# 3. IMPORT DATA
# ============================================================

data <- read.csv("data.csv")

# Excel import
# data <- read_excel("data.xlsx")

# Download stock data
# getSymbols("AAPL", src = "yahoo")


# ============================================================
# 4. DATA INSPECTION AND CLEANING
# ============================================================

head(data)
tail(data)
str(data)
summary(data)
dim(data)

colSums(is.na(data))
data <- na.omit(data)


# ============================================================
# 5. DESCRIPTIVE STATISTICS
# ============================================================

mean(data)
sd(data)
var(data)
skewness(data)
kurtosis(data)

stats <- data.frame(
  Mean = mean(data),
  SD = sd(data),
  Variance = var(data),
  Skewness = skewness(data),
  Kurtosis = kurtosis(data)
)

stats


# ============================================================
# 6. VISUALIZATION
# ============================================================

plot(data, type = "l")

# ggplot
# ggplot(data, aes(x = Date, y = Price)) +
#   geom_line() +
#   theme_minimal()


# ============================================================
# 7. TIME SERIES CONVERSION
# ============================================================

Y <- ts(data)
YY <- ts(data)


# ============================================================
# 8. LOG TRANSFORMATION AND RETURNS
# ============================================================

log_data <- log(data)

returns <- diff(log(data))

percentage_returns <- diff(data) / lag(data) * 100


# ============================================================
# 9. ADF STATIONARITY TEST
# ============================================================

adf.test(data)

adf <- ur.df(data, type = "drift", selectlags = "AIC")
summary(adf)

# Trend version
adf_trend <- ur.df(data, type = "trend", selectlags = "AIC")
summary(adf_trend)


# ============================================================
# 10. DIFFERENCING
# ============================================================

d_data <- diff(data)

d2_data <- diff(data, differences = 2)

adf.test(d_data)


# ============================================================
# 11. ARIMA MODEL
# ============================================================

model <- auto.arima(data)

summary(model)

# Manual ARIMA
model_manual <- Arima(data, order = c(1,1,1))

summary(model_manual)

# Residuals
residuals(model)

# Residual diagnostics
checkresiduals(model)


# ============================================================
# 12. ARIMA FORECAST
# ============================================================

fc <- forecast(model, h = 10)

fc

plot(fc)


# ============================================================
# 13. ACF AND PACF
# ============================================================

acf(data)

pacf(data)


# ============================================================
# 14. ARCH EFFECT TEST
# ============================================================

ArchTest(data, lags = 12)


# ============================================================
# 15. GARCH MODEL
# ============================================================

spec <- ugarchspec(
  variance.model = list(model = "sGARCH", garchOrder = c(1,1)),
  mean.model = list(armaOrder = c(0,0))
)

fit <- ugarchfit(spec = spec, data = data)

fit

# Forecast GARCH
fc_garch <- ugarchforecast(fit, n.ahead = 10)

plot(fc_garch)


# ============================================================
# 16. VAR LAG SELECTION
# ============================================================

lag <- VARselect(YY, lag.max = 10, type = "const")

lag$selection

# Example: Select lag using SC
p <- lag$selection["SC(n)"]


# ============================================================
# 17. VAR MODEL
# ============================================================

model_var <- VAR(YY, p = as.numeric(p), type = "const")

summary(model_var)


# ============================================================
# 18. GRANGER CAUSALITY
# ============================================================

causality(model_var, cause = colnames(YY)[1])

causality(model_var, cause = colnames(YY)[2])


# ============================================================
# 19. IRF (IMPULSE RESPONSE FUNCTION)
# ============================================================

irf_result <- irf(
  model_var,
  impulse = colnames(YY)[1],
  response = colnames(YY)[2],
  n.ahead = 10,
  boot = TRUE
)

plot(irf_result)


# ============================================================
# 20. FEVD (FORECAST ERROR VARIANCE DECOMPOSITION)
# ============================================================

fevd_result <- fevd(model_var, n.ahead = 10)

plot(fevd_result)


# ============================================================
# 21. COINTEGRATION - JOHANSEN TEST
# ============================================================

jo <- ca.jo(YY, type = "trace", ecdet = "const", K = 2)

summary(jo)


# ============================================================
# 22. VECM MODEL
# ============================================================

vec <- VECM(
  YY,
  lag = 1,
  r = 1,
  estim = "ML"
)

summary(vec)


# ============================================================
# 23. VECM IRF
# ============================================================

irf_vec <- irf(
  vec,
  n.ahead = 10,
  boot = TRUE
)

plot(irf_vec)


# ============================================================
# 24. MULTIVARIATE GARCH
# ============================================================

# Create univariate specifications
spec1 <- ugarchspec(
  variance.model = list(model = "sGARCH", garchOrder = c(1,1)),
  mean.model = list(armaOrder = c(0,0))
)

spec_multi <- multispec(replicate(2, spec1))

# DCC specification
dcc_spec <- dccspec(
  uspec = spec_multi,
  dccOrder = c(1,1),
  distribution = "mvnorm"
)

dcc_fit <- dccfit(dcc_spec, data = YY)

dcc_fit


# ============================================================
# 25. BEKK MODEL
# ============================================================

bekk_fit <- BEKKs::bekk_fit(
  data = YY
)

bekk_fit


