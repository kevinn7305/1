cat > lab8.pig <<'EOF'
products = LOAD 'products.txt' USING PigStorage(',') AS (product:chararray, category:chararray, sales:int);
DUMP products;
grouped = GROUP products BY category;
DUMP grouped;
result = FOREACH grouped GENERATE group, COUNT(products);
DUMP result;
electronics = FILTER products BY category == 'Electronics';
DUMP electronics;
EOF


